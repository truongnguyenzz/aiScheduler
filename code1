function previewOptimizedSchedule(transferInput) {
  const validated = validateOptimizedSchedule_(transferInput);
  const sortedTasks = transferInput.tasks.slice().sort(function (left, right) {
    return left.date.localeCompare(right.date) ||
      left.schedule_order - right.schedule_order;
  });
  return {
    fingerprint: fingerprint_(JSON.stringify(transferInput)),
    destinationTab: validated.destinationTab,
    taskCount: validated.rows.length,
    days: validated.days,
    rows: validated.rows,
    taskModes: sortedTasks.map(function (task) {
      return task.task_type === "flexible" &&
        task.duration_hours !== task.original_duration_hours
        ? "flexible_adjusted"
        : task.task_type;
    }),
    taskOriginalDurations: sortedTasks.map(function (task) {
      return task.original_duration_hours;
    }),
    warnings: validated.warnings,
  };
}

function writeOptimizedSchedule(transferInput, expectedFingerprint) {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const validated = validateOptimizedSchedule_(transferInput);
    if (
      !expectedFingerprint ||
      expectedFingerprint !== fingerprint_(JSON.stringify(transferInput))
    ) {
      throw new Error(
        "File lịch đã thay đổi sau khi xem trước. Hãy tải lên và kiểm tra lại."
      );
    }
    const database = openDatabase_();
    const sheet = getOrCreateDatabaseTab_(
      database,
      validated.destinationTab
    );
    const previousLastRow = sheet.getLastRow();
    if (previousLastRow > 1) {
      sheet
        .getRange(2, 1, previousLastRow - 1, DATABASE_HEADERS.length)
        .clearContent();
    }
    sheet
      .getRange(2, 1, validated.rows.length, DATABASE_HEADERS.length)
      .setValues(validated.rows);
    PropertiesService.getScriptProperties().setProperty(
      LAST_WRITTEN_TAB_PROPERTY,
      validated.destinationTab
    );
    return {
      status: "written",
      destinationTab: validated.destinationTab,
      taskCount: validated.rows.length,
      dayCount: validated.days.length,
    };
  } finally {
    lock.releaseLock();
  }
}

